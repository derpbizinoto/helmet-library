<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.seuestudio.helmetlibrary"
    ExtensionBundleVersion="1.3.5" ExtensionBundleName="Helmet Library"
    xmlns:ExtensionBundleId="http://ns.adobe.com/extension">
    <ExtensionList>
        <Extension Id="com.seuestudio.helmetlibrary.panel" Version="1.3.5" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- PPRO cobre Premiere Pro. importMGT (MOGRT na timeline) existe desde o Premiere 13. -->
            <Host Name="PPRO" Version="[15.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.seuestudio.helmetlibrary.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- Node para ler as pastas (fs), abrir MOGRTs (zlib) e gravar o cache -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <!-- deixa o preview de áudio/vídeo tocar sem clique prévio -->
                        <Parameter>--autoplay-policy=no-user-gesture-required</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Helmet Library</Menu>
                    <Geometry>
                        <Size>
                            <Height>520</Height>
                            <Width>900</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>420</Width>
                        </MinSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon_normal.png</Icon>
                        <Icon Type="RollOver">./icons/icon_rollover.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon_dark_normal.png</Icon>
                        <Icon Type="DarkRollOver">./icons/icon_dark_rollover.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
